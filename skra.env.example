# Copy to skra.env and fill in. Skra has no defaults: every variable below is
# required and the server refuses to start if one is missing or empty.

# Internal bind address. Bind to localhost so only the reverse proxy reaches it.
SKRA_LISTEN=127.0.0.1:3000

# SQLite database file location (created on first run).
SKRA_DB_PATH=/var/lib/skra/skra.db

# Whether to set the Secure flag on cookies. Must be "true" or "false". Drive
# this from the EXTERNAL scheme (true behind HTTPS), not the internal HTTP
# connection the app actually sees behind the proxy.
SKRA_COOKIE_SECURE=true

# --- First-run admin bootstrap (only read by `skra create-admin`) ---
# Used once to create the initial admin account, then can be removed. The
# command refuses to run if the database already has any users.
SKRA_ADMIN_USERNAME=admin
SKRA_ADMIN_EMAIL=admin@example.com
SKRA_ADMIN_PASSWORD=change-me
